<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MINHA MOTO"
            android:letterSpacing="0.2"
            android:textColor="#E53935"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sheetState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Moto desconectada"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sheetDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.7"
            android:textSize="13sp" />

        <Button
            android:id="@+id/sheetConnect"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Procurar a moto" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="ENTRADA NO PAINEL"
            android:letterSpacing="0.15"
            android:alpha="0.6"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/sheetRider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="Seu nome (aparece no &quot;Bem-vindo&quot;)"
            android:importantForAutofill="no"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="16"
            android:maxLines="1" />

        <EditText
            android:id="@+id/sheetBike"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Sua moto e o ano (ex.: Zontes T350X 2024)"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:maxLength="40"
            android:maxLines="1" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sheetIntro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Animação de entrada ao conectar" />

        <Button
            android:id="@+id/sheetPreview"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="▶ Ver a animação aqui" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="PAINEL RACE"
            android:letterSpacing="0.15"
            android:alpha="0.6"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/sheetRacePreview"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="▶ Prévia" />

            <Button
                android:id="@+id/sheetResetTrip"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Zerar viagem" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="COMBUSTÍVEL"
            android:letterSpacing="0.15"
            android:alpha="0.6"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sheetFuel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/sheetRefuel"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="⛽ Enchi o tanque"
                android:textSize="13sp" />

            <Button
                android:id="@+id/sheetStation"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Posto perto"
                android:textSize="13sp" />

            <Button
                android:id="@+id/sheetFuelCfg"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="MANUTENÇÃO"
            android:letterSpacing="0.15"
            android:alpha="0.6"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sheetMaint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="15sp" />

        <Button
            android:id="@+id/sheetMaintBtn"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🔧 Hodômetro e manutenção" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="VIAGENS"
            android:letterSpacing="0.15"
            android:alpha="0.6"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/sheetTrips"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="📒 Minhas viagens" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="MAPA DO PAINEL À NOITE"
            android:letterSpacing="0.15"
            android:alpha="0.6"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/sheetNight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/nightAuto"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Automático" />

            <Button
                android:id="@+id/nightDay"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="☀ Claro" />

            <Button
                android:id="@+id/nightNight"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🌙 Escuro" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="MÚSICA NO PAINEL"
            android:letterSpacing="0.15"
            android:alpha="0.6"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/sheetMusic"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🎵 Mostrar a música (Spotify) no painel" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sheetMessages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="💬 Avisar mensagens no painel (só o nome de quem mandou)" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sheetRideScreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🔋 Tela de pilotagem: com a Economia de energia ligada, deixar a tela acesa e preta para o GPS não parar" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="SEGURANÇA"
            android:letterSpacing="0.15"
            android:alpha="0.6"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/sheetCrash"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🆘 Detecção de queda" />

        <Button
            android:id="@+id/sheetTomTom"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🗝 Chave TomTom (trânsito e incidentes)" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="AJUDA"
            android:letterSpacing="0.15"
            android:alpha="0.6"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sheetCompat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Enviar o diagnóstico de cada conexão ao suporte (deu certo ou erro)" />

        <Button
            android:id="@+id/sheetReport"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="📤 Enviar relatório (quando algo não funcionar)" />

        <Button
            android:id="@+id/sheetWizard"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🧭 Assistente de configuração" />

        <Button
            android:id="@+id/sheetUpdate"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🔄 Procurar atualização" />

        <Button
            android:id="@+id/sheetDiag"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:alpha="0.6"
            android:text="Diagnóstico e pareamento"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
