<?xml version="1.0" encoding="utf-8"?>
<!-- Tela inicial: escolher o que vai para o painel (Navegação ou Race) e atalhos -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0F"
    android:clickable="true"
    android:fillViewport="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- logo -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="MOTO"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="italic" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="5dp"
                android:background="#FF7A00"
                android:letterSpacing="0.3"
                android:paddingStart="8dp"
                android:paddingEnd="6dp"
                android:text="NAV"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/homeGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:letterSpacing="0.25"
            android:text="BOA NOITE"
            android:textColor="#FF7A00"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/homeHello"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="Olá!"
            android:textColor="#FFFFFF"
            android:textSize="34sp" />

        <!-- conexão com a moto -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/homeConnCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#17181F"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#2A2C36"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏍"
                    android:textSize="32sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/homeConnTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Moto desconectada"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/homeConnDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Painel da moto"
                        android:textColor="#9AA0AC"
                        android:textSize="13sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/homeConnect"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#FF7A00"
                    android:text="Conectar"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/homeBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/home_due_bg"
            android:padding="12dp"
            android:text="⚡ O Android está economizando bateria no MotoNav: o painel pode travar com a tela apagada. Toque para liberar  ›"
            android:textColor="#FFB066"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:letterSpacing="0.2"
            android:text="ESCOLHA A TELA"
            android:textColor="#9AA0AC"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="no celular e no painel da moto"
            android:textColor="#6B7180"
            android:textSize="12sp" />

        <!-- Navegação | Race -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/homeMapCard"
                android:layout_width="0dp"
                android:layout_height="190dp"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#17181F"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="#2A2C36"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="🗺"
                        android:textSize="44sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="Navegação"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mapa, rotas, radares e avisos"
                        android:textColor="#9AA0AC"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/homeRaceCard"
                android:layout_width="0dp"
                android:layout_height="190dp"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#17181F"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="#2A2C36"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="🏁"
                        android:textSize="44sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="Race"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Velocímetro e números da viagem"
                        android:textColor="#9AA0AC"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView
            android:id="@+id/homePanelNow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="No painel agora: Navegação"
            android:textColor="#6B7180"
            android:textSize="12sp" />

        <!-- números rápidos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/homeFuel"
                style="@style/HomeStat"
                android:layout_marginEnd="6dp"
                android:text="⛽\n—" />

            <TextView
                android:id="@+id/homeOdo"
                style="@style/HomeStat"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:text="📟\n—" />

            <TextView
                android:id="@+id/homeWeather"
                style="@style/HomeStat"
                android:layout_marginStart="6dp"
                android:text="🌡\n—" />
        </LinearLayout>

        <TextView
            android:id="@+id/homeDue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/home_due_bg"
            android:padding="12dp"
            android:textColor="#FFB066"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- atalhos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/homeRoutes"
                style="@style/HomeAction"
                android:layout_marginEnd="6dp"
                android:text="★\nRotas" />

            <Button
                android:id="@+id/homeTrips"
                style="@style/HomeAction"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:text="📒\nViagens" />

            <Button
                android:id="@+id/homeGarage"
                style="@style/HomeAction"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:text="🔧\nManutenção" />

            <Button
                android:id="@+id/homeSettings"
                style="@style/HomeAction"
                android:layout_marginStart="6dp"
                android:text="⚙\nAjustes" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
